#!/sbin/sh

# ========================================
# update-binary
# 
# 重要：此文件必须使用Magisk官方脚本！
# 不要在此文件中添加任何自定义逻辑！
# 自定义安装逻辑应放在 customize.sh 中
# ========================================

# 下载最新的官方安装脚本
ump > /dev/null 2>&1

# 或者使用内嵌的简化安装逻辑（仅用于无法联网的情况）
# 完整版请参考：https://github.com/topjohnwu/Magisk/blob/master/scripts/module_installer.sh

# 以下为基础安装逻辑
OUTFD=$1
ZIPFILE=$2

ui_print() {
    echo "ui_print $1" >&$OUTFD
    echo "$1"
}

# 提取模块文件
mkdir -p /sbin/.coreimg
cd /sbin/.coreimg
unzip -o "$ZIPFILE"

# source customize.sh
[ -f customize.sh ] && sh customize.sh

exit 0
